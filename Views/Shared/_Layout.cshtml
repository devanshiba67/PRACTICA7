
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Feedback Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f4f7fb;
        }

        .navbar {
            background: #17365d;
        }

        .main-container {
            max-width: 950px;
            margin: 35px auto;
            min-height: 70vh;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #666;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand"
               asp-controller="Feedback" asp-action="Index">
                Feedback Management
            </a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link"
                   asp-controller="Feedback" asp-action="Index">
                    Home
                </a>

                <a class="nav-link"
                   asp-controller="Feedback" asp-action="Create">
                    Give Feedback
                </a>
            </div>
        </div>
    </nav>

    <main class="container main-container">
        @RenderBody()
    </main>

    <footer>
        Feedback Management System | ASP.NET Core MVC
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
